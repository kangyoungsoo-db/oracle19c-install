# -*- mode: ruby -*-
# Oracle Database 19c on Oracle Linux 8 — v2
#
# 놓는 위치:  D:\vagrant\oracle19c\Vagrantfile
# 설치 파일:  D:\vagrant\media\LINUX.X64_193000_db_home.zip   (이 폴더의 한 칸 위 media 폴더)
# 실행:       🪟 PowerShell에서  cd D:\vagrant\oracle19c ; vagrant up
#
# v1과 달라진 점
# - OS: Rocky 9(비인증) → Oracle Linux 8 공식 박스 (Oracle이 직접 배포, glibc 우회 불필요)
# - Ansible: WSL에서 원격 실행 → VM 안에서 실행(ansible_local). Windows에 WSL/Ansible 설치 불필요
# - 경로: 모두 이 폴더 기준 상대 경로. 드라이브 문자나 사용자 이름을 코드에 넣지 않음

VM_NAME   = "dbts94"
VM_IP     = "192.168.10.94"
VM_MEMORY = 4096          # MB. 4GB 미만이면 vars.yml의 total_memory_mb도 줄일 것
VM_CPUS   = 2

# 추가 디스크 (GB). 크기를 서로 다르게 두어야 합니다.
# Ansible이 /dev/sdb 같은 장치 이름 대신 "크기"로 어느 디스크인지 찾기 때문입니다.
DISKS = { "u01" => 50, "oradata" => 60, "backup" => 70 }

Vagrant.configure("2") do |config|
  config.vm.box      = "oraclelinux/8"
  # 2026-10-28 검증한 박스로 고정. 새 박스로 바꾸려면 이 줄을 고치고 다시 검증(README §9)
  config.vm.box_version = "8.10.700"
  config.vm.box_url  = "https://oracle.github.io/vagrant-projects/boxes/oraclelinux/8.json"
  config.vm.hostname = "#{VM_NAME}.localdomain"
  config.vm.define VM_NAME

  # Host-Only 네트워크. Windows는 어떤 대역이든 되지만,
  # Linux/macOS 호스트는 /etc/vbox/networks.conf에 192.168.10.0/24를 허용해야 합니다.
  config.vm.network "private_network", ip: VM_IP

  # 설치 파일 폴더(../media)를 VM의 /stage에 읽기 전용으로 연결
  config.vm.synced_folder "../media", "/stage", mount_options: ["ro"]

  config.vm.provider "virtualbox" do |vb|
    vb.name   = VM_NAME
    vb.memory = VM_MEMORY
    vb.cpus   = VM_CPUS
    DISKS.each_with_index do |(name, gb), i|
      disk = File.join(__dir__, "disks", "#{name}.vdi")
      unless File.exist?(disk)
        vb.customize ["createmedium", "disk", "--filename", disk, "--size", gb * 1024, "--format", "VDI"]
      end
      # Oracle 공식 박스의 컨트롤러 이름은 "SATA Controller", 0번 포트는 OS 디스크
      vb.customize ["storageattach", :id, "--storagectl", "SATA Controller",
                    "--port", i + 1, "--device", 0, "--type", "hdd", "--medium", disk]
    end
  end

  # 1단계: Ansible 설치 (OL8 AppStream의 ansible-core) + 로그 폴더
  config.vm.provision "bootstrap", type: "shell", inline: <<-SHELL
    set -e
    mkdir -p /vagrant/logs
    rpm -q ansible-core acl >/dev/null 2>&1 || dnf -y -q install ansible-core acl
    ansible --version | head -1
  SHELL

  # 2단계: Oracle 설치 (VM 안에서 Ansible 실행)
  config.vm.provision "oracle", type: "ansible_local" do |a|
    a.install           = false
    a.compatibility_mode = "2.0"   # ansible-core 2.16 — "unknown Ansible version" 경고 제거
    a.provisioning_path = "/vagrant/ansible"
    a.config_file       = "/vagrant/ansible/ansible.cfg"
    a.playbook          = "site.yml"
    a.extra_vars        = { db_hostname: VM_NAME, db_ip: VM_IP, disk_sizes_gb: DISKS }
    a.tags              = ENV["ORA_TAGS"] if ENV["ORA_TAGS"]   # 예: $env:ORA_TAGS="verify"; vagrant provision --provision-with oracle
  end
end
